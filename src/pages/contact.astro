---
import Base from '../layouts/Base.astro';
import Aura from '../components/Aura.astro';
import Email from '../components/Email.astro';
import { site, hasPhone } from '../data/site.js';

const title = `Contact & accès — ${site.cabinet.nom}`;
const description =
  `Contacter ${site.cabinet.nom}, cabinet d'ostéopathie à ${site.cabinet.ville} : ` +
  'téléphone, email, horaires, plan d\'accès. Prise de rendez-vous en ligne via Doctolib.';

const tel = site.cabinet.telephone.replace(/\s/g, '');
const itineraire = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(
  `${site.cabinet.adresse}, ${site.cabinet.codePostal} ${site.cabinet.ville}`
)}`;
---

<Base title={title} description={description}>
  <section class="page-hero">
    <Aura />
    <h1>Contact</h1>
    <p class="page-lead">
      {hasPhone
        ? 'Pour la prise de rendez-vous, vous pouvez me joindre par téléphone ou réserver directement un créneau en ligne via Doctolib.'
        : 'Pour la prise de rendez-vous, réservez directement un créneau en ligne via Doctolib ou écrivez-moi par e-mail.'}
    </p>
  </section>

  <section class="contact-section">
    <div class="container contact-grid">
      <div class="contact-info reveal">
        <div class="contact-primary">
          <a class="btn btn-primary" href={site.liens.doctolib} target="_blank" rel="noopener">
            Prendre rendez-vous
          </a>
          <span class="contact-or">ou</span>
          <div class="contact-channels">
            {hasPhone && (
              <>
                <a class="contact-tel" href={`tel:${tel}`}>{site.cabinet.telephone}</a>
                <span class="contact-channels-sep" aria-hidden="true">·</span>
              </>
            )}
            <span class="contact-email"><Email /></span>
          </div>
        </div>

        <div class="contact-divider" aria-hidden="true"></div>

        <div class="contact-secondary">
          <div class="contact-address">
            <address>
              {site.cabinet.adresse}<br />
              {site.cabinet.codePostal} {site.cabinet.ville}
            </address>
            <p class="contact-extra">{site.cabinet.parking}</p>
          </div>
          <ul class="horaires">
            {site.horaires.map((h) => (
              <li>
                <span>{h.jours}</span>
                <strong>{h.heures}</strong>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="map-wrap reveal" style="--reveal-delay: 0.12s">
        <div
          id="map"
          data-lat={site.cabinet.latitude}
          data-lon={site.cabinet.longitude}
          data-nom={site.cabinet.nom}
        ></div>
        <a class="map-link" href={itineraire} target="_blank" rel="noopener">
          Itinéraire vers le cabinet<span aria-hidden="true"> →</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  let map: L.Map | undefined;

  function initMap() {
    map?.remove();
    map = undefined;

    const el = document.getElementById('map');
    if (!el) return;

    const lat = Number(el.dataset.lat);
    const lon = Number(el.dataset.lon);
    map = L.map(el, { scrollWheelZoom: false, attributionControl: false }).setView([lat, lon], 14);
    L.control
      .attribution({ prefix: false })
      .addAttribution('© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>')
      .addTo(map);
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19 }).addTo(map);
    L.marker([lat, lon], {
      icon: L.divIcon({
        className: '',
        html: '<div class="cabinet-marker"></div>',
        iconSize: [34, 34],
        iconAnchor: [17, 41],
      }),
    })
      .addTo(map)
      .bindPopup(el.dataset.nom ?? '');
  }

  // Le module n'est évalué qu'une fois : à partir de la 2ᵉ arrivée sur la page
  // via ClientRouter, seul cet événement redonne la main pour recréer la carte
  // dans le conteneur fraîchement échangé.
  document.addEventListener('astro:page-load', initMap);

  // Le conteneur va disparaître du DOM : sans ce démontage, l'instance Leaflet
  // survit avec ses écouteurs window (resize, orientationchange).
  document.addEventListener('astro:before-swap', () => {
    map?.remove();
    map = undefined;
  });
</script>

<style>
  .page-lead {
    text-align: center;
    max-width: 36rem;
    margin: var(--spacing-s) auto 0;
    padding-inline: clamp(1.25rem, 4vw, 2rem);
  }

  .contact-grid {
    display: grid;
    gap: var(--spacing-l);
    align-items: start;
  }

  @media (min-width: 820px) {
    .contact-grid { grid-template-columns: 2fr 3fr; }
  }

  .page-hero { padding-bottom: var(--spacing-m); }

  .contact-section { padding-top: var(--spacing-m); }

  .contact-info {
    display: flex;
    flex-direction: column;
    container-type: inline-size;
  }

  /* Empilé et centré par défaut : la symétrie bouton/téléphone de part et
     d'autre du "ou" a besoin de plus de largeur que la colonne n'en offre
     tant qu'elle n'a pas dépassé son point de bascule (y compris en layout
     2 colonnes desktop, où cette colonne reste étroite). Container query
     plutôt que media query : ce qui compte est la largeur de la colonne,
     pas celle du viewport. */
  .contact-primary {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.6rem;
  }

  .contact-or {
    color: var(--color-text-secondary);
    font-size: var(--font-body);
  }

  /* Téléphone et email sont deux moyens de contact équivalents,
     regroupés sur une même ligne plutôt qu'empilés en blocs distincts. */
  .contact-channels {
    display: flex;
    align-items: baseline;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.3rem 0.6rem;
    font-size: var(--font-body);
  }

  .contact-channels-sep { color: var(--color-text-secondary); }

  .contact-tel {
    font-family: var(--bodyFont);
    font-weight: 600;
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .contact-tel:hover { text-decoration: underline; text-underline-offset: 4px; }

  .contact-email { color: var(--color-text-secondary); }

  .contact-email a { color: inherit; }

  .contact-email a:hover { color: var(--color-text-primary); }

  @container (min-width: 430px) {
    .contact-primary {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center;
      gap: 0.75rem 1.25rem;
    }

    .contact-primary .btn { justify-self: end; white-space: nowrap; }

    .contact-or { justify-self: center; }

    .contact-channels { justify-self: start; }
  }

  .contact-divider {
    width: 2.5rem;
    height: 3px;
    border-radius: 999px;
    background: var(--color-primary-accent);
    opacity: 0.4;
    margin: var(--spacing-l) 0;
  }

  /* Rythme vertical du bloc : un gap sur le conteneur plutôt que des
     margin-top ad hoc sur chaque enfant, pour que l'espacement entre
     groupes (adresse, horaires) reste garanti et lisible d'un coup
     d'œil dans la feuille de style. */
  .contact-secondary {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    font-size: var(--font-body);
    color: var(--color-text-secondary);
  }

  .contact-secondary > * { margin: 0; }

  .contact-address {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .contact-address address { font-style: normal; }

  .contact-extra { font-size: var(--font-mini); }

  .horaires {
    list-style: none;
    padding: 0;
  }

  .horaires li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--color-light-border);
  }

  .horaires li:first-child { padding-top: 0; }

  .horaires li:last-child { padding-bottom: 0; border-bottom: none; }

  .horaires li > span,
  .horaires li > strong {
    white-space: nowrap;
  }

  .horaires strong { color: var(--color-text-primary); }

  .map-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  #map {
    width: 100%;
    min-height: 380px;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-light-border);
    z-index: var(--zindex-map);
  }

  #map :global(.cabinet-marker) {
    width: 34px;
    height: 34px;
    border-radius: 50% 50% 50% 0;
    transform: rotate(-45deg);
    background: var(--color-green500);
    border: 3px solid var(--color-white);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
  }

  .map-link {
    align-self: flex-start;
    font-weight: 600;
    text-decoration: none;
  }

  .map-link:hover { text-decoration: underline; text-underline-offset: 4px; }
</style>
