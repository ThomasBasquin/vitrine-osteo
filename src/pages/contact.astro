---
import Base from '../layouts/Base.astro';
import Aura from '../components/Aura.astro';
import Email from '../components/Email.astro';
import { site, hasPhone } from '../data/site.js';

const title = `Contact & accès — ${site.cabinet.nom}`;
const description =
  `Contacter ${site.cabinet.nom}, cabinet d'ostéopathie à ${site.cabinet.ville} : ` +
  'téléphone, email, horaires, plan d\'accès. Prise de rendez-vous en ligne via Doctolib.';

const tel = site.cabinet.telephone.replace(/\s/g, '');
const itineraire = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(
  `${site.cabinet.adresse}, ${site.cabinet.codePostal} ${site.cabinet.ville}`
)}`;
---

<Base title={title} description={description}>
  <section class="page-hero">
    <Aura />
    <h1>Contact</h1>
    <p class="page-lead">
      {hasPhone
        ? 'Pour la prise de rendez-vous, vous pouvez me joindre par téléphone ou réserver directement un créneau en ligne via Doctolib.'
        : 'Pour la prise de rendez-vous, réservez directement un créneau en ligne via Doctolib ou écrivez-moi par e-mail.'}
    </p>
  </section>

  <section class="contact-section">
    <div class="container contact-grid">
      <div class="contact-info">
        <div class="contact-card reveal">
          <a
            class="btn btn-primary contact-cta"
            href={site.liens.doctolib}
            target="_blank"
            rel="noopener"
          >
            Prendre rendez-vous
          </a>
          <p class="contact-alt"><span>ou</span></p>
          <ul class="info-rows">
            {hasPhone && (
              <li>
                <span>Téléphone</span>
                <a class="info-value" href={`tel:${tel}`}>{site.cabinet.telephone}</a>
              </li>
            )}
            <li>
              <span>E-mail</span>
              <span class="info-email"><Email /></span>
            </li>
          </ul>
        </div>

        <div class="contact-hours reveal" style="--reveal-delay: 0.08s">
          <h2 class="block-title">Horaires</h2>
          <ul class="info-rows">
            {site.horaires.map((h) => (
              <li>
                <span>{h.jours}</span>
                <strong>{h.heures}</strong>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="map-card reveal" style="--reveal-delay: 0.12s">
        <div
          id="map"
          data-lat={site.cabinet.latitude}
          data-lon={site.cabinet.longitude}
          data-nom={site.cabinet.nom}
        ></div>
        <div class="map-foot">
          <div>
            <address>
              {site.cabinet.adresse}<br />
              {site.cabinet.codePostal} {site.cabinet.ville}
            </address>
            <p class="map-extra">{site.cabinet.parking}</p>
          </div>
          <a class="btn btn-outline map-link" href={itineraire} target="_blank" rel="noopener">
            Itinéraire<span aria-hidden="true"> →</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  let map: L.Map | undefined;

  function initMap() {
    map?.remove();
    map = undefined;

    const el = document.getElementById('map');
    if (!el) return;

    const lat = Number(el.dataset.lat);
    const lon = Number(el.dataset.lon);
    map = L.map(el, { scrollWheelZoom: false, attributionControl: false }).setView([lat, lon], 14);
    L.control
      .attribution({ prefix: false })
      .addAttribution('© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>')
      .addTo(map);
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19 }).addTo(map);
    L.marker([lat, lon], {
      icon: L.divIcon({
        className: '',
        html: '<div class="cabinet-marker"></div>',
        iconSize: [34, 34],
        iconAnchor: [17, 41],
      }),
    })
      .addTo(map)
      .bindPopup(el.dataset.nom ?? '');
  }

  // Le module n'est évalué qu'une fois : à partir de la 2ᵉ arrivée sur la page
  // via ClientRouter, seul cet événement redonne la main pour recréer la carte
  // dans le conteneur fraîchement échangé.
  document.addEventListener('astro:page-load', initMap);

  // Le conteneur va disparaître du DOM : sans ce démontage, l'instance Leaflet
  // survit avec ses écouteurs window (resize, orientationchange).
  document.addEventListener('astro:before-swap', () => {
    map?.remove();
    map = undefined;
  });
</script>

<style>
  .page-lead {
    text-align: center;
    max-width: 36rem;
    margin: var(--spacing-s) auto 0;
    padding-inline: clamp(1.25rem, 4vw, 2rem);
  }

  /* Empilé, la mesure est bornée sur celle du chapô : sans ça le CTA pleine
     largeur de la carte s'étire sur toute la colonne dès la tablette. */
  .contact-grid {
    display: grid;
    gap: var(--spacing-l);
    align-items: start;
    max-width: 36rem;
  }

  /* La carte étirée sur toute la hauteur de la colonne voisine : les deux
     colonnes se terminent au même niveau quel que soit le contenu de gauche. */
  @media (min-width: 820px) {
    .contact-grid {
      grid-template-columns: 2fr 3fr;
      align-items: stretch;
      max-width: 78rem;
    }
  }

  .page-hero { padding-bottom: var(--spacing-m); }

  .contact-section { padding-top: var(--spacing-m); }

  /* Hero sans sous-navigation ni contenu long : le plancher commun aux pages
     à Aura laissait 240px de dégradé nu sous le chapô avant les cartes. */
  @media (min-width: 992px) {
    section.page-hero { min-height: clamp(520px, 44vw, 640px); }

    /* La colonne plafonne avec la grille tandis que --font-body continue de
       grandir : passé 1600px l'e-mail ne tient plus sur sa ligne. */
    .info-value,
    .info-email :global(a) { font-size: var(--font-link); }
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .contact-card {
    padding: clamp(1.5rem, 5vw, 2rem);
    background: var(--color-opaque);
    border: 1px solid var(--color-light-border);
    border-radius: var(--radius-card);
  }

  /* .btn est inline-flex : le repasser en flex pour qu'il occupe la largeur
     de la carte et devienne la cible évidente du bloc. */
  .contact-cta {
    display: flex;
    width: 100%;
  }

  .contact-alt {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 1.25rem 0 0;
    font-size: var(--font-mini);
    color: var(--color-text-secondary);
  }

  .contact-alt::before,
  .contact-alt::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-light-border);
  }

  /* Rangées étiquette / valeur partagées par les moyens de contact et les
     horaires : même rythme de filets sur toute la colonne. */
  .info-rows {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--font-body);
    color: var(--color-text-secondary);
  }

  .info-rows li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.2rem 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-light-border);
  }

  .info-rows li:last-child { padding-bottom: 0; border-bottom: none; }

  /* margin-left auto plutôt que le seul space-between : garde la valeur
     calée à droite même quand elle passe à la ligne (e-mail long). */
  .info-rows strong,
  .info-value {
    margin-left: auto;
    font-weight: 600;
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .info-rows > li > span:first-child,
  .info-rows strong { white-space: nowrap; }

  /* Le <a> vient d'Email.astro : hors de la portée du style scopé de cette
     page, d'où le wrapper porteur de la mise en page et le :global() ici. */
  .info-email {
    margin-left: auto;
    overflow-wrap: anywhere;
  }

  .info-email :global(a) {
    font-weight: 600;
    color: var(--color-text-primary);
    text-decoration: none;
  }

  @media (hover: hover) {
    .info-value:hover,
    .info-email :global(a:hover) { text-decoration: underline; text-underline-offset: 4px; }
  }

  .block-title {
    font-size: var(--font-h3);
    margin-bottom: 0.75rem;
  }

  .contact-hours .info-rows { border-top: 1px solid var(--color-light-border); }

  .map-card {
    display: flex;
    flex-direction: column;
    background: var(--color-opaque);
    border: 1px solid var(--color-light-border);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  #map {
    flex: 1 1 auto;
    width: 100%;
    min-height: 340px;
    z-index: var(--zindex-map);
  }

  .map-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.9rem 1.5rem;
    padding: clamp(1.1rem, 4vw, 1.5rem) clamp(1.25rem, 4vw, 1.75rem);
    border-top: 1px solid var(--color-light-border);
  }

  .map-foot address {
    font-style: normal;
    font-size: var(--font-body);
    font-weight: 600;
    line-height: 1.4;
  }

  .map-extra {
    margin: 0.35rem 0 0;
    font-size: var(--font-mini);
  }

  #map :global(.cabinet-marker) {
    width: 34px;
    height: 34px;
    border-radius: 50% 50% 50% 0;
    transform: rotate(-45deg);
    background: var(--color-green500);
    border: 3px solid var(--color-white);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
  }

  .map-link {
    flex: none;
    padding: 0.6rem 1.25rem;
  }
</style>
